---
import { BRAND_NAME, BASE, SITE_URL, FAVICON, OG_IMAGE } from '../site';
const { title, seoTitle, description, name, tagline, accent, accent2, bg, ink, nav } = Astro.props;
const pageTitle = seoTitle || title;
const url = new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/', SITE_URL).toString();
const ogImg = new URL(OG_IMAGE, SITE_URL).toString();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={url} />
<link rel="icon" type="image/png" href={FAVICON} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={BRAND_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={ogImg} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImg} />
<style is:global define:vars={{ accent, accent2, bg, ink }}>
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;overflow-x:clip}
  .demo-banner{background:#0B1F3A;color:#fff;font-size:13px;padding:8px 16px;text-align:center}
  .demo-banner a{color:#7FD4FF;font-weight:700}
  .demo-banner a:hover{color:#fff}
  .demo-wrap{max-width:1060px;margin:0 auto;padding:0 20px}
  .demo-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px;flex-wrap:wrap}
  .demo-head .dname{font-family:Georgia,serif;font-size:22px;font-weight:700;letter-spacing:-.02em}
  .demo-head nav{display:flex;gap:4px;flex-wrap:wrap}
  .demo-head nav a{color:var(--ink);text-decoration:none;font-weight:600;font-size:14px;padding:8px 12px;border-radius:8px}
  .demo-head nav a:hover{background:rgba(0,0,0,.06)}
  .demo-hero{padding:56px 0 40px;border-bottom:2px solid var(--ink)}
  .demo-hero h1{font-family:Georgia,serif;font-size:clamp(32px,5.5vw,52px);line-height:1.05;letter-spacing:-.02em;margin:0 0 16px}
  .demo-hero p.lead{font-size:19px;max-width:640px;margin:0 0 24px}
  .demo-hero .cta{display:inline-block;background:var(--accent);color:#fff;text-decoration:none;font-weight:700;padding:14px 26px;border-radius:10px}
  .demo-hero .cta:hover{filter:brightness(1.08)}
  .demo-sec{padding:48px 0}
  .demo-sec h2{font-family:Georgia,serif;font-size:clamp(24px,3.5vw,32px);letter-spacing:-.02em;margin:0 0 8px}
  .demo-sec .sub{color:#555;max-width:640px;margin:0 0 28px}
  .demo-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;align-items:start}
  .demo-card{background:#fff;border:1px solid #e2ddd3;border-radius:14px;padding:20px;box-shadow:0 2px 0 rgba(0,0,0,.04)}
  .demo-card h3{margin:0 0 6px;font-size:18px}
  .demo-card p{margin:0;color:#444;font-size:15px}
  .demo-card .price{font-weight:800;color:var(--accent);font-size:17px;margin-top:10px}
  .demo-list{list-style:none;margin:0;padding:0}
  .demo-list li{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid #e2ddd3}
  .demo-list li b{font-weight:700}
  .demo-list li span{color:#555}
  .demo-list li .pr{font-weight:800;color:var(--accent);white-space:nowrap}
  .demo-two{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;align-items:start}
  .demo-box{background:#fff;border:1px solid #e2ddd3;border-radius:14px;padding:24px}
  .demo-box h3{margin:0 0 8px}
  .demo-box p{margin:0;color:#444}
  .demo-foot{border-top:2px solid var(--ink);padding:32px 20px 48px;color:#555;font-size:14px}
  .demo-foot a{color:var(--accent);font-weight:700}
  .demo-form label{display:block;font-weight:600;font-size:14px;margin:14px 0 4px}
  .demo-form input,.demo-form select,.demo-form textarea{width:100%;padding:12px;border:1px solid #c9c2b4;border-radius:8px;font-size:16px;font-family:inherit}
  .demo-form button{background:var(--accent);color:#fff;border:0;font-weight:700;padding:14px 26px;border-radius:10px;font-size:16px;cursor:pointer;margin-top:18px}
  @media (max-width:820px){.demo-grid,.demo-two{grid-template-columns:1fr}.demo-hero{padding:40px 0 32px}.demo-sec{padding:36px 0}}
</style>
</head>
<body>
<div class="demo-banner">Demo website — example scope, not a client. Built by <a href={BASE + '/'}>{BRAND_NAME}</a>. <a href={BASE + '/work'}>See our work →</a></div>
<header class="demo-wrap demo-head">
<span class="dname">{name}</span>
<nav>{nav.map((n:any) => <a href={n.href}>{n.label}</a>)}</nav>
</header>
<slot />
<footer class="demo-wrap demo-foot">
<p><b>{name}</b> — {tagline}</p>
<p>Demo website built by {BRAND_NAME} to show what a site like this looks like. The business, people, prices and hours on this page are examples, not real. <a href={BASE + '/contact'}>Want one like this? Contact us →</a></p>
<p>© 2026 {BRAND_NAME}. Canada.</p>
</footer>
</body>
</html>
