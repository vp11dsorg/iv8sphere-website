---
import Base from '../layouts/Base.astro';
import { BRAND_NAME, BASE } from '../site';
import { PRACTICES } from '../data/services';
const faqs=[
 ['How much does a website cost?','Every project is quoted. Tell us your budget and we tell you what fits, in writing, before you commit.'],
 ['How long does it take?','Most websites: 4–6 weeks from first call to launch.'],
 ['Where are you based?','In Canada.'],
 ['Do you certify us for HIPAA or PCI DSS?','No — and no vendor can. Your auditor certifies you. We build the systems and prepare the evidence so you can pass.'],
 ['What does a website cost?','We have no starting price yet and no fixed price list. Every project is quoted after we scope it in writing — tell us your budget and we tell you what fits.'],
 ['Can I edit the site myself?','Yes. We build sites you can edit yourself, show you how, and stay on call for the rest.'],
 ['Who will I actually work with?','The people doing the work — a designer, a developer and a strategist on a website project. No account managers in between.'],
];
const demos=[
 {slug:'maple-main',name:'Maple & Main Café',kind:'Small business website',desc:'Menu, hours, bookings — a café site that gets people through the door.'},
 {slug:'northwood-outfitters',name:'Northwood Outfitters',kind:'Online store',desc:'Products, prices and a checkout that works on a phone.'},
 {slug:'harbour-dental',name:'Harbour Dental',kind:'Service business website',desc:'Services, team and booking — a clinic site that answers questions before the call.'},
];
---
<Base>
<section class="hero"><div class="container hero-grid">
<div>
<span class="kicker-chip">Web design · Managed hosting · Cloud — Based in Canada</span>
<h1 style="margin-top:20px">Your business has grown. <em>Your website should show it.</em></h1>
<p class="sub">We design, build, run and staff your technology — one team, start to finish — so your business keeps working without you managing the technology.</p>
<p class="tech">For non-technical owners: we do the technology, you run your business. For technical teams: the detail is on every service page.</p>
<div class="cta-row"><a class="btn" href={`${BASE}/contact`}>Contact us →</a><a class="btn ghost" href={`${BASE}/services`}>See all services</a></div>
<div class="trust-chips"><span>10–20 specialists</span><span>Based in Canada</span><span>One team start to finish</span><span>No lock-in</span></div>
</div>
<div class="specsheet" aria-label="What fits, at a glance">
<header><b>What fits, at a glance</b><span>Spec sheet</span></header>
<div class="spec-row"><b>Design</b><span>WordPress — 38.6% of the web</span><a href={`${BASE}/services/web-design`}>VIEW →</a></div>
<div class="spec-row"><b>Hosting</b><span>Daily backups · SSL · monitored</span><a href={`${BASE}/services/managed-hosting`}>VIEW →</a></div>
<div class="spec-row"><b>Cloud</b><span>Managed clusters · upgrades included</span><a href={`${BASE}/services/professional-services`}>VIEW →</a></div>
<div class="spec-row"><b>AI &amp; compliance</b><span>Practical AI · readiness, not certification</span><a href={`${BASE}/services/professional-services`}>VIEW →</a></div>
<footer><b>No fixed price list.</b> We scope before we quote — tell us your budget and we tell you what fits, in writing.</footer>
</div>
</div></section>

<section class="tight"><div class="container"><div class="facts">
<span><b>What we do:</b> design, hosting, cloud, AI, compliance, talent.</span>
<span><b>Who it's for:</b> small businesses, growing stores, technical teams in Canada.</span>
<span><b>What you get:</b> a fast site you own, hosting that is watched, people you can call.</span>
<span><b>Next:</b> contact us → we scope it in writing → you decide.</span>
</div></div></section>

<section><div class="container">
<div class="section-head"><p class="eyebrow">Start where your problem is</p><h2>Three doors, <em>one team</em> behind all of them.</h2></div>
<div class="grid3">
<div class="card silo hub-card hub-web"><span class="tag">Website Services</span><h3>I need a website that works</h3><p class="plain">A website, store or app your customers love — and you can edit yourself.</p><a href={`${BASE}/services/website-services`}>Website Services →</a></div>
<div class="card silo hub-card hub-host"><span class="tag">Managed Hosting</span><h3>My site must stay up</h3><p class="plain">Managed WordPress, VPS and dedicated — set up, secured, backed up and watched.</p><a href={`${BASE}/services/managed-hosting`}>Managed Hosting →</a></div>
<div class="card silo hub-card hub-pro"><span class="tag">Professional Services</span><h3>We need specialists</h3><p class="plain">Cloud, containers, AI, compliance readiness, consultancy and staffing — by specialists.</p><a href={`${BASE}/services/professional-services`}>Professional Services →</a></div>
</div></div></section>

<section style="background:var(--bg)"><div class="container">
<div class="section-head"><p class="eyebrow">Seven practices</p><h2>Good design is <em>just the beginning.</em></h2><p class="lead">Design is one of seven practices — not the headline, not a footnote. Each one stands alone.</p></div>
<div class="grid3">{PRACTICES.map(p => <div class="card silo"><h3>{p.name}</h3><p class="plain">{p.short}</p><p class="tech">{p.proof}</p><a href={BASE + "/practices/" + p.slug}>Explore {p.name} →</a></div>)}</div>
</div></section>

<section><div class="container">
<div class="section-head"><p class="eyebrow">Managed hosting</p><h2>Hosting, priced like a spec sheet.</h2><p class="lead">Same layout for every plan: what you get, what it is best for, what it costs. Custom quote, scoped to your traffic.</p></div>
<div class="plans">
<div class="plan"><header><span class="tag">Small &amp; quiet sites</span><h3>Managed WordPress</h3></header><p class="price">Custom quote <small>/mo</small></p><ul class="spec"><li><span>Platform</span><b>WordPress · LiteSpeed</b></li><li><span>Backups</span><b>Daily · self-restore</b></li><li><span>Security</span><b>SSL · WAF · malware scan</b></li></ul><footer><a href={`${BASE}/services/managed-wordpress`}>View details →</a></footer></div>
<div class="plan hot"><header><span class="tag">Most sites that outgrow shared</span><h3>Managed VPS</h3></header><p class="price">Custom quote <small>/mo</small></p><ul class="spec"><li><span>Resources</span><b>Dedicated CPU · RAM · NVMe</b></li><li><span>Neighbours</span><b>None can slow you down</b></li><li><span>Backups</span><b>Daily · staging included</b></li></ul><footer><a href={`${BASE}/services/vps-hosting`}>View details →</a></footer></div>
<div class="plan"><header><span class="tag">Busy stores &amp; large sites</span><h3>Dedicated Server</h3></header><p class="price">Custom quote <small>/mo</small></p><ul class="spec"><li><span>Hardware</span><b>Whole server · yours alone</b></li><li><span>Storage</span><b>Hardware RAID</b></li><li><span>Backups</span><b>Daily · off-site options</b></li></ul><footer><a href={`${BASE}/services/dedicated-hosting`}>View details →</a></footer></div>
</div>
<p style="margin-top:24px"><strong>Right pick:</strong> quiet WordPress site → Managed WordPress. Several sites, or slow at busy times → Managed VPS. Downtime costs real money → Dedicated. Not sure? Tell us your traffic — we check first and say so honestly.</p>
</div></section>

<section style="background:var(--bg)"><div class="container">
<div class="section-head"><p class="eyebrow">A clear, collaborative process</p><h2>From idea to <em>a website you're proud to share.</em></h2></div>
<div class="steps">
<div class="step"><b>01</b><h3>Discover</h3><p>Week 1 — we learn your business and your goals.</p><div class="you"><b>You do:</b> one 45-min call + a short brief.</div></div>
<div class="step"><b>02</b><h3>Design</h3><p>Weeks 2–3 — wireframes, then visual design. You see it on desktop and phone.</p><div class="you"><b>You do:</b> 2 rounds of feedback.</div></div>
<div class="step"><b>03</b><h3>Build</h3><p>Weeks 3–5 — design becomes a fast, working site.</p><div class="you"><b>You do:</b> approve content.</div></div>
<div class="step"><b>04</b><h3>Launch</h3><p>Week 5–6 — every page tested, then live.</p><div class="you"><b>You do:</b> nothing — we handle it.</div></div>
<div class="step"><b>05</b><h3>Care</h3><p>Ongoing — hosting, updates, backups and small changes.</p><div class="you"><b>You do:</b> run your business.</div></div>
</div>
<p style="margin-top:20px"><a href={`${BASE}/process`}>See the full process →</a></p></div></section>

<section><div class="container">
<div class="section-head"><p class="eyebrow">Selected work</p><h2>A little less talking. <em>A lot more showing.</em></h2><p class="lead">Detailed, typical projects of each type. Example scopes, not named client projects.</p></div>
<div class="grid3">
<div class="work-card"><div class="art"><span class="pill">Example scope · Website</span><b>Small business website</b></div><div class="body"><p>A service business that lived on phone calls, with a website that did not explain what it did or let anyone book.</p><a href={`${BASE}/work/small-business-website`}>Read the full example scope →</a></div></div>
<div class="work-card"><div class="art"><span class="pill">Example scope · Store</span><b>Online store, rebuilt</b></div><div class="body"><p>A small shop whose checkout was losing sales on phones.</p><a href={`${BASE}/work/online-store`}>Read the full example scope →</a></div></div>
<div class="work-card"><div class="art"><span class="pill">Example scope · Hosting</span><b>Managed WordPress migration</b></div><div class="body"><p>A WordPress site that kept breaking, with backups that had never been tested.</p><a href={`${BASE}/work/wordpress-migration`}>Read the full example scope →</a></div></div>
</div>
<div class="section-head" style="margin-top:44px"><p class="eyebrow">Demo websites</p><h2 style="font-size:28px">Click through a real demo.</h2><p class="lead">Three complete demo sites — a café, a store, a dental clinic. Demo — example, not a client.</p></div>
<div class="grid3">{demos.map(d => <div class="work-card"><div class="art"><span class="pill">Demo · {d.kind}</span><b>{d.name}</b></div><div class="body"><p>{d.desc}</p><a href={`${BASE}/demos/${d.slug}`}>Open the demo →</a></div></div>)}</div>
<p style="margin-top:20px"><a href={`${BASE}/work`}>See all example scopes →</a></p></div></section>

<section><div class="container">
<div class="section-head"><p class="eyebrow">The humans behind the pixels</p><h2>You talk to <em>the people doing the work.</em></h2>
<p class="lead">A small, senior team of 10–20 specialists in Canada — designers, developers, cloud engineers, compliance specialists and recruiters. No account managers passing messages along, no being handed from person to person. The same people from your first call to launch, and the same people you call afterwards.</p></div>
<p><a class="btn ghost" href={BASE + "/about"}>Meet the team →</a></p>
</div></section>

<section style="background:var(--bg)"><div class="container">
<div class="section-head"><p class="eyebrow">Contact us</p><h2>{BRAND_NAME} — Based in Canada.</h2><p class="lead">Tell us your goal. We reply within 1 business day with a written scope and quote — before you commit to anything.</p></div>
<p><strong>Email:</strong> not published yet. <strong>Phone:</strong> not published yet. <strong>Address:</strong> not published yet — both will be added here when confirmed.</p>
<p><a class="btn" href={`${BASE}/contact`}>Contact us →</a></p>
</div></section>

<section><div class="container faq"><div class="section-head"><p class="eyebrow">The good-to-know stuff</p><h2>A few things <em>you might be wondering.</em></h2></div>
{faqs.map(f=><details><summary>{f[0]}</summary><p style="margin-top:10px">{f[1]}</p></details>)}
</div></section>
</Base>
