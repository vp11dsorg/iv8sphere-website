---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Tell iv8Sphere about your project — a real reply within 1 business day.">
<section><div class="container"><div class="grid2">
<div><p class="eyebrow">Contact</p><h1>Tell us about your project.</h1><p>One short form. A real reply within 1 business day.</p><p><strong>Email:</strong> hello@iv8sphere.example<br/><strong>Based in Canada.</strong> Working worldwide.<br/><strong>Book a call:</strong> tell us a time in your message and we'll confirm.</p></div>
<div>
<form id="contact-form">
<label for="name">Name</label><input id="name" name="name" required />
<label for="email">Email</label><input id="email" name="email" type="email" required />
<label for="company">Company</label><input id="company" name="company" />
<label for="budget">Budget</label><select id="budget" name="budget"><option>Under $5k</option><option>$5–15k</option><option>$15–50k</option><option>$50k+</option><option>Not sure</option></select>
<label for="type">Project type</label><select id="type" name="type"><option>Website Services</option><option>Managed Hosting</option><option>Professional Services</option><option>Something else</option></select>
<label for="message">Message</label><textarea id="message" name="message" rows="5" placeholder="What do you need, and by when?"></textarea>
<button class="btn" type="submit">Send →</button>
<p id="form-ok" style="display:none;margin-top:12px"><strong>Thanks — your message is ready to send.</strong> This static form has no backend yet; email us directly at hello@iv8sphere.example and we'll reply within 1 business day.</p>
</form>
<script>
document.getElementById('contact-form').addEventListener('submit', function(e){ e.preventDefault(); document.getElementById('form-ok').style.display='block'; });
const q = new URLSearchParams(location.search); const s = q.get('service'); if (s) { const t=document.getElementById('type'); }
</script>
</div>
</div></div></section>
</Base>
