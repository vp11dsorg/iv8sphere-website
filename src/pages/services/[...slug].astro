---
import Base from '../../layouts/Base.astro';
import { SERVICES, PRACTICES } from '../../data/services';
import { BASE, BRAND_NAME, seoTitle } from '../../site';
export function getStaticPaths() {
  return SERVICES.map(s => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service } = Astro.props;
const practice = PRACTICES.find(p => p.slug === service.practice);
const others = SERVICES.filter(s => s.practice === service.practice && s.slug !== service.slug);
const groupOthers = SERVICES.filter(s => s.group === service.group && s.slug !== service.slug);
---
<Base title={service.title} seoTitle={seoTitle(service.short)} description={service.plain.slice(0, 155)}>
<section><div class="container">
<p class="breadcrumb"><a href={`${BASE}/services`}>Services</a> / <a href={`${BASE}/practices/${service.practice}`}>{practice ? practice.name : service.group}</a> / {service.title}</p>
<p class="eyebrow">{practice ? practice.name : service.group} · {service.group}</p>
<h1>{service.title}</h1>
<p style="font-size:21px;max-width:760px;color:var(--ink);font-weight:600">{service.tagline}</p>
<div class="note" style="margin:24px 0"><strong>One team, start to finish:</strong> {BRAND_NAME} designs, builds, runs and staffs your technology — so your business keeps working, without you managing the technology. This service is one part of that. Buy it alone, or with the rest.</div>
<h2>In plain English</h2>
<p style="max-width:760px">{service.plain}</p>
<h2>Technically</h2>
<p style="max-width:760px">{service.technical}</p>
<div class="duo" style="margin:32px 0">
<div class="plain-box"><h4>Who it is for</h4><ul>{service.whoFor.map(x => <li>{x}</li>)}</ul></div>
<div class="tech-box"><h4>Who it is NOT for</h4><ul>{service.notFor.map(x => <li>{x}</li>)}</ul></div>
</div>
<h2>What you get</h2>
<ul class="check">{service.deliverables.map(d => <li><b>{d.t}</b> — {d.d}</li>)}</ul>
<h2 style="margin-top:40px">How it works</h2>
<div class="steps four">{service.steps.map((st,i) => <div class="step"><b>{String(i+1).padStart(2,'0')}</b><h3>{st.t}</h3><p>{st.d}</p></div>)}</div>
<h2 style="margin-top:40px">What it costs</h2>
<p style="max-width:760px">Every project is quoted, and we scope before we quote — a number produced without seeing your business is a guess you would end up budgeting against. Tell us your budget in the form and we tell you what fits, in writing, before you commit. No fixed price list, no hidden fees.</p>
<div class="table-scroll"><table class="compare"><tr><th>What changes the price</th><th>How</th></tr>{service.costDrivers.map(c => <tr><td>{c.t}</td><td>{c.d}</td></tr>)}</table></div>
<h2 style="margin-top:40px">Before you ask</h2>
<div class="faq">{service.faqs.map(f => <details><summary>{f.q}</summary><p style="margin-top:10px">{f.a}</p></details>)}</div>
<h2 style="margin-top:40px">More in {practice ? practice.name : service.group}</h2>
<div class="grid3">{others.map(o => <div class="card"><h3>{o.title}</h3><p>{o.tagline}</p><a href={`${BASE}/services/${o.slug}`}>Explore {o.title} →</a></div>)}</div>
<p style="margin-top:32px"><a class="btn" href={`${BASE}/contact?service=${service.slug}`}>Book a strategy call →</a> <a class="btn ghost dark" style="color:var(--navy);border-color:var(--navy)" href={`${BASE}/practices/${service.practice}`}>See the full practice →</a></p>
</div></section>
</Base>
